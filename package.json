{
  "name": "profile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "ci:check": "biome ci ./src",
    "type-check": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "prepare": "husky"
  },
  "lint-staged": {
    "./**/*.{js,jsx,ts,tsx}": [
      "npm run check"
    ]
  },
  "dependencies": {
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "5.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.2.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "husky": "9.1.4",
    "lint-staged": "17.6.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
